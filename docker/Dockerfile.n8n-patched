# Build a SEPARATE, non-production upstream source sandbox. No production credentials.
# This build stage stops at upstream compiled artifacts, without deploying services.
FROM node:26.12.1-bookworm-slim AS build
ENV CI=true NODE_OPTIONS=--max-old-space-size=6144
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git python3 make g++ pkg-config cmake libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@12.4.2
WORKDIR /src/n8n
RUN git clone --depth 1 --branch 'n8n@2.44.6' https://github.com/n8n-io/n8n.git . \
 && test "$(git rev-parse HEAD)" = 'b58d9e89d60e9a3485bb511c5091d8be0d9511e4'
COPY packages/pan /shared/packages/pan
COPY scripts/apply-pan-patch.mjs /shared/scripts/apply-pan-patch.mjs
RUN node /shared/scripts/apply-pan-patch.mjs /src/n8n/packages/frontend/editor-ui/src/features/workflows/canvas/components/Canvas.vue
RUN pnpm install --frozen-lockfile --trust-lockfile && pnpm build:deploy
